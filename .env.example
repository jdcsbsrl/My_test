# 复制本文件为 `.env` 后填写；不要将含真实密码的 `.env` 提交到 Git。
#
# 测试环境访问验证（与 UAT 功能对齐、数据隔离依赖独立部署与下列 URL 变量）：
#   TEST_USERNAME=你的测试账号
#   TEST_PASSWORD=在本地填写登录口令
#
TEST_USERNAME=
TEST_PASSWORD=
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
TEST_SALES_USERNAME=
TEST_SALES_PASSWORD=
TEST_TEAM_LEADER_USERNAME=
TEST_TEAM_LEADER_PASSWORD=
# 以下三项若使用「浏览器拦截登录」回归（test_login_regression_multi_env）可不填，由脚本自动从页面请求中获取
TEST_CLIENTID=
TEST_ENCRYPT_KEY=
TEST_ENCRYPTED_LOGIN_PASSWORD=
# 与 UAT 区分网页/API 入口时设置（pytest --env=test 或 test_env 时生效；登录回归里 test_env 栈会读此基址）
TEST_WEB_BASE_URL=
TEST_WEB_API_BASE_URL=
# UAT 环境配置（用于 login_regression_test.py）
UAT_WEB_BASE_URL=
UAT_WEB_API_BASE_URL=
# OpenAPI 客户端配置（用于 OpenAPIClient 初始化）
OPENAPI_BASE_URL=
OPENAPI_APP_KEY=
OPENAPI_APP_SECRET=
UAT_USERNAME=
UAT_PASSWORD=
UAT_ADMIN_USERNAME=
UAT_ADMIN_PASSWORD=
UAT_SALES_USERNAME=
UAT_SALES_PASSWORD=
UAT_TEAM_LEADER_USERNAME=
UAT_TEAM_LEADER_PASSWORD=
# Test Env 环境配置
TEST_ENV_USERNAME=
TEST_ENV_PASSWORD=
# 示例测试账号（勿将含真实口令的 .env 提交）：TEST_USERNAME=15137651220
# 可选：自动将 pytest 失败写入 .agents/failure_auto_log.md
# AGENT_FEEDBACK_AUTO=1
